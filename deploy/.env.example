# Variables de docker-compose.prod.yml. Copiar a deploy/.env (no se sube a ningún lado).

# Dominios (registros A apuntando a la IP del servidor). Pueden ser subdominios del mismo dominio.
WEB_DOMAIN=crm.tu-inmobiliaria.com.ar
API_DOMAIN=api.crm.tu-inmobiliaria.com.ar
# Email para Let's Encrypt (avisa si un certificado no se puede renovar).
ACME_EMAIL=sistemas@tu-inmobiliaria.com.ar

# Contraseña de la base. Generar con: openssl rand -hex 24  (solo letras y números: va dentro de una URL)
POSTGRES_PASSWORD=

# Días de backups que se guardan en ./backups
BACKUP_KEEP_DAYS=14
# Proxies delante de la API: 1 = solo Caddy · 2 = Cloudflare (nube naranja) + Caddy
TRUST_PROXY=1
