{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "migration:generate": "nest build && typeorm migration:generate -d dist/data-source.js",
    "migration:run": "nest build && typeorm migration:run -d dist/data-source.js",
    "migration:revert": "nest build && typeorm migration:revert -d dist/data-source.js",
    "migration:baseline": "nest build && typeorm migration:run --fake -d dist/data-source.js",
    "storage:to-s3": "tsc -p tsconfig.build.json --outDir dist-scripts && node dist-scripts/scripts/migrate-storage-to-s3.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "storage:check": "tsc -p tsconfig.build.json --outDir dist-scripts && node dist-scripts/scripts/check-storage.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@aws-sdk/client-s3": "3.1141.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "nodemailer": "10.0.11",
    "pdfkit": "0.20.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "11.2.6",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "30.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "typescript": "^5.6.0"
  }
}
