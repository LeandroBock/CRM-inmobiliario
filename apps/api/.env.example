# Base de datos (docker-compose publica PostGIS en el 5433)
DATABASE_URL=postgres://crm:crm@localhost:5433/crm
# Bases en la nube (Supabase, Neon...): conexión cifrada. DATABASE_CA_CERT (opcional): certificado PEM para verificarla.
DATABASE_SSL=false
DATABASE_CA_CERT=
# Conexiones simultáneas a la base (10 por defecto; Supabase gratis: 5)
DATABASE_POOL_MAX=
# Solo desarrollo. En producción se borra: las tablas se actualizan con migraciones.
DB_SYNC=true
AVM_SERVICE_URL=http://localhost:8000
# Dirección de la web (CORS y links de los emails). Admite varias separadas por coma; los links usan la primera.
WEB_ORIGIN=http://localhost:5173
# Producción (docker-compose.prod.yml ya pone estas dos):
#   NODE_ENV=production  -> la API no arranca con configuración de desarrollo y dice qué corregir
#   TRUST_PROXY=1        -> cantidad de proxies delante (Caddy, Cloudflare...) para ver la IP real del cliente

# Fotos subidas: carpeta en disco y URL pública con la que se arman los links.
# Para publicar en redes, PUBLIC_URL tiene que ser accesible desde internet (no localhost).
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:3000

# Archivos en la nube (recomendado en producción: en muchos hostings el disco se borra en cada deploy).
# local = disco (UPLOAD_DIR) · s3 = AWS S3, Cloudflare R2 o compatible. Ver README > Archivos en S3/R2.
STORAGE_DRIVER=local
S3_ENDPOINT=                 # R2: https://<id-de-cuenta>.r2.cloudflarestorage.com · AWS: vacío
S3_REGION=auto               # R2: auto · AWS: la región del bucket (us-east-1, sa-east-1...)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BUCKET=            # fotos de propiedades: bucket con acceso público
S3_PUBLIC_URL=               # URL pública de ese bucket (dominio de R2 o CloudFront), sin barra final
S3_PRIVATE_BUCKET=           # audios y fotos de clientes: bucket SIN acceso público

# Autenticación
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_HOURS=8
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Asistente de WhatsApp (Claude). Vacío = asistente apagado: los mensajes los contesta un asesor desde el CRM.
ANTHROPIC_API_KEY=
# Solo para transcribir audios de WhatsApp (la API de Claude no recibe audio). Sin clave, el asistente le pide al cliente que escriba.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1
LLM_MODEL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Plantilla para retomar conversaciones de más de 24 h. Crearla en Meta Business (categoría "Marketing" o "Utility")
# con UNA variable en el cuerpo, el nombre del cliente. Ejemplo:
#   "Hola {{1}}, te escribe la inmobiliaria. ¿Seguís buscando propiedad? Respondé este mensaje y seguimos."
# Si no se configura, el CRM avisa que la ventana está cerrada y no deja escribir.
WHATSAPP_REENGAGE_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es_AR
# Milisegundos que espera el asistente antes de contestar, por si el cliente sigue escribiendo
# ("Hola" / "busco depto" / "en Centro" = una sola respuesta). Cada mensaje nuevo reinicia la espera.
WHATSAPP_REPLY_DELAY_MS=4000
# Leads nuevos de WhatsApp: se asignan al asesor activo con menos leads abiertos. false = quedan sin asignar.
AUTO_ASSIGN_LEADS=true

# Avisos por email a los asesores (SMTP). Sin SMTP_HOST no se manda nada: los avisos quedan solo en el CRM.
# Gmail/Workspace: smtp.gmail.com, puerto 465 o 587, SMTP_USER = la cuenta y SMTP_PASS = una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CRM Inmobiliaria <avisos@tu-dominio.com>"

# Google Calendar (cada asesor conecta su cuenta desde la Agenda). Ver README > Google Calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Por defecto: PUBLIC_URL + /integrations/google/callback (tiene que coincidir con la de Google Cloud)
GOOGLE_REDIRECT_URI=
# Cifra los tokens de Google en la base. Generar con: openssl rand -base64 32
# Si se pierde o se cambia, cada asesor tiene que volver a conectar su calendario.
TOKEN_ENCRYPTION_KEY=

# Redes sociales
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
TIKTOK_ACCESS_TOKEN=
